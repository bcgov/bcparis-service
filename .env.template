# BCPARIS Service Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git

# Service Configuration
HOSTNAME=<your-hostname>

# Keystore Configuration
SERVICE_KEYSTORE_PASSWORD=<your-keystore-password>
SERVICE_KEYSTORE_JKS=<path-to-your-keystore>

# POR (Protection Order Registry) Configuration
ENDPOINT_POR_REST_USERNAME=<your-por-username>
ENDPOINT_POR_REST_PASSWORD=<your-por-password>

# Layer 7 MQ Configuration
ENDPOINT_LAYER7_REST_HEADER_USERNAME=<your-layer7-username>
ENDPOINT_LAYER7_REST_HEADER_PASSWORD=<your-layer7-password>

# ICBC API Configuration
ENDPOINT_ICBC_REST_HEADER_IMSUSERID=<your-icbc-userid>
ENDPOINT_ICBC_REST_HEADER_IMSCREDENTIAL=<your-icbc-credential>
ENDPOINT_ICBC_REST_HEADER_USERNAME=<your-icbc-username>
ENDPOINT_ICBC_REST_HEADER_PASSWORD=<your-icbc-password>

# Email Service Configuration
ENDPOINT_IAMP_EMAIL_SERVICE_REST_USERNAME=<your-email-service-username>
ENDPOINT_IAMP_EMAIL_SERVICE_REST_PASSWORD=<your-email-service-password>

# Database Configuration (if applicable)
SPRING_DATASOURCE_USERNAME=<your-db-username>
SPRING_DATASOURCE_PASSWORD=<your-db-password>

# Logging Configuration
CONSOLE_LOG_PATTERN=<your-log-pattern>

# Splunk Configuration
splunk-url=<your-splunk-url>
splunk-token=<your-splunk-token>
application-name=bcparis-service
